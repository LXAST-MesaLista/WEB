# Se ejecuta en Ubuntu: siempre con saltos de línea LF
*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.js      text eol=lf
*.ejs     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.md      text eol=lf

# Binarios: nunca se tocan los saltos de línea
*.pdf  binary
*.png  binary
*.ico  binary
