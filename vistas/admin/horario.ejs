<%# Horario. Variables: franjas (weekday, open, close), cerrados (fechas) y hoy. %>
<h1 class="h3 mb-3">Horario</h1>

<form class="card card-body shadow-sm mb-4" method="post" action="/panel/admin/horario">
  <%- Csrf.campo() %>
  <h2 class="h5">Franjas de servicio</h2>
  <p class="small text-body-secondary">
    Las horas de inicio se ofrecen desde la apertura hasta una duración de reserva antes del cierre.
    Usa 00:00 como cierre para medianoche. Para añadir una franja, rellena la fila vacía del día;
    para quitarla, marca «Quitar».
  </p>
  <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-3">
<% let n = 0; -%>
<% Admin.DIAS.forEach((dia, i) => { -%>
    <div class="col">
      <fieldset class="border rounded-3 p-2 h-100">
        <legend class="h6 float-none w-auto px-1 mb-1"><%= dia %></legend>
<% for (const s of [...franjas.filter((f) => f.weekday === i + 1), null]) { -%>
        <div class="d-flex align-items-center gap-1 mb-2">
          <input type="hidden" name="slots[<%= n %>][weekday]" value="<%= i + 1 %>">
          <input class="form-control form-control-sm" type="time" step="300" name="slots[<%= n %>][open]" value="<%= s?.open ?? '' %>"
                 aria-label="<%= dia %>: apertura">
          <span aria-hidden="true">–</span>
          <input class="form-control form-control-sm" type="time" step="300" name="slots[<%= n %>][close]" value="<%= s?.close ?? '' %>"
                 aria-label="<%= dia %>: cierre">
<% if (s !== null) { -%>
          <div class="form-check form-check-inline m-0 ms-1">
            <input class="form-check-input" type="checkbox" name="slots[<%= n %>][quitar]" value="1" id="f-quitar-<%= n %>">
            <label class="form-check-label small" for="f-quitar-<%= n %>">Quitar</label>
          </div>
<% } else { -%>
          <span class="small text-body-secondary ms-1 text-nowrap">nueva</span>
<% } -%>
        </div>
<% n++; } -%>
      </fieldset>
    </div>
<% }) -%>
  </div>
  <div><button class="btn btn-primary" type="submit">Guardar franjas</button></div>
</form>

<section class="card card-body shadow-sm">
  <h2 class="h5">Días cerrados</h2>
  <p class="small text-body-secondary">Un día cerrado no ofrece ninguna hora. Las reservas que ya existen se mantienen.</p>
  <form class="d-flex flex-wrap gap-2 mb-3" method="post" action="/panel/admin/horario/cerrar">
    <%- Csrf.campo() %>
    <label class="visually-hidden" for="f-cerrar">Día que se cierra</label>
    <input class="form-control w-auto" type="date" id="f-cerrar" name="date" min="<%= hoy %>" required>
    <button class="btn btn-outline-danger" type="submit">Cerrar ese día</button>
  </form>
<% if (!cerrados.length) { -%>
  <p class="text-body-secondary mb-0">No hay días cerrados próximamente.</p>
<% } else { -%>
  <ul class="list-group">
<% for (const d of cerrados) { -%>
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <%= mayuscula(Formato.fechaLarga(d)) %>
      <form method="post" action="/panel/admin/horario/abrir">
        <%- Csrf.campo() %>
        <input type="hidden" name="date" value="<%= d %>">
        <button class="btn btn-sm btn-outline-secondary" type="submit">Reabrir</button>
      </form>
    </li>
<% } -%>
  </ul>
<% } -%>
</section>
