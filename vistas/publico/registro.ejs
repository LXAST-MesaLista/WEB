<%# Crear cuenta. Variables: datos (name, email, phone), errores y next. %>
<h1 class="h3 mb-3">Crear cuenta</h1>

<% if (errores._ !== undefined) { -%>
  <div class="alert alert-danger" role="alert"><%= errores._ %></div>
<% } -%>

<form class="card card-body shadow-sm mb-3" method="post" action="<%= url('/registro', { next }) %>">
  <%- Csrf.campo() %>
  <%- campo('name', 'Nombre', datos.name, { required: true, minlength: 2, maxlength: 80, autocomplete: 'name' }, null, errores) %>
  <%- campo('email', 'Correo electrónico', datos.email, { type: 'email', required: true, maxlength: 254, autocomplete: 'email' }, null, errores) %>
  <%- campo('phone', 'Teléfono', datos.phone, { type: 'tel', required: true, maxlength: 25, autocomplete: 'tel', placeholder: '+34 600 000 000' },
      'Solo se usa para avisarte de una incidencia con tu reserva y para añadir reservas hechas en el local.', errores) %>
  <%- campo('password', 'Contraseña', '', { type: 'password', required: true, minlength: 10, maxlength: 128, autocomplete: 'new-password' },
      'Al menos 10 caracteres. Evita contraseñas comunes.', errores) %>
  <%- campo('password2', 'Repite la contraseña', '', { type: 'password', required: true, minlength: 10, maxlength: 128, autocomplete: 'new-password', 'data-igual-a': 'f-password' }, null, errores) %>
  <button class="btn btn-primary btn-lg w-100" type="submit">Crear cuenta</button>
</form>

<p class="text-center">¿Ya tienes cuenta? <a href="<%= url('/entrar', { next }) %>">Inicia sesión</a></p>
