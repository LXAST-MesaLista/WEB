<%# Pedir el enlace para cambiar la contraseña. Variables: email y errores. %>
<a class="d-inline-block mb-3" href="/entrar">‹ Iniciar sesión</a>
<h1 class="h3 mb-2">¿Has olvidado tu contraseña?</h1>
<p class="text-body-secondary">Te enviaremos un enlace para elegir otra.</p>

<% if (errores._ !== undefined) { -%>
  <div class="alert alert-danger" role="alert"><%= errores._ %></div>
<% } -%>

<form class="card card-body shadow-sm" method="post" action="/recuperar">
  <%- Csrf.campo() %>
  <%- campo('email', 'Correo electrónico de tu cuenta', email, { type: 'email', required: true, maxlength: 254, autocomplete: 'username', autofocus: true }, null, errores) %>
  <button class="btn btn-primary btn-lg w-100" type="submit">Enviar enlace</button>
</form>
