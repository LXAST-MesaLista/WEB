<%#
  Portada. Variables: cfg (configuración pública o null), error, hoy,
  maxDia, usuario, avisos (del restaurante) y proximas (reservas).

  Rejilla Bento (.bento, en mesalista.css): bienvenida y buscador arriba; con
  sesión, próximas reservas, avisos y el número de reservas pendientes; al
  final, los accesos rápidos.
%>
<div class="bento">
  <section class="bento-celda bento-marca portada-bienvenida bento-md-6 bento-lg-7">
<% if (usuario !== null) { -%>
    <p class="fw-semibold mb-2">Hola, <%= usuario.name %></p>
<% } -%>
    <h1 class="mb-3">Reserva tu mesa</h1>
    <p class="lead mb-0">
      Elige el día y cuántos sois, y te enseñamos las horas libres.
      Después puedes cambiar o cancelar la reserva desde «Mis reservas».
    </p>
  </section>

  <section class="bento-celda bento-md-6 bento-lg-5" aria-labelledby="buscar-titulo">
    <h2 class="bento-etiqueta" id="buscar-titulo">Buscar mesa</h2>
<% if (cfg === null) { -%>
    <div class="alert alert-warning mb-0" role="alert"><%= error %></div>
<% } else { -%>
    <form class="d-flex flex-column flex-grow-1" method="get" action="/reservar">
      <div class="row g-3">
        <div class="col-sm-7">
          <label class="form-label" for="f-fecha">Día</label>
          <input class="form-control form-control-lg" type="date" id="f-fecha" name="fecha" required
                 value="<%= hoy %>" min="<%= hoy %>" max="<%= maxDia %>">
        </div>
        <div class="col-sm-5">
          <label class="form-label" for="f-personas">Personas</label>
          <select class="form-select form-select-lg" id="f-personas" name="personas">
<% for (let n = Number(cfg.min_party); n <= Number(cfg.max_party); n++) { -%>
            <option value="<%= n %>"<%- n === 2 ? ' selected' : '' %>><%= n %></option>
<% } -%>
          </select>
        </div>
      </div>
      <div class="bento-pie">
        <button class="btn btn-primary btn-lg w-100" type="submit">Ver horas libres</button>
        <p class="form-text mb-0 mt-2">
          Se puede reservar con hasta <%= Number(cfg.max_advance_days) %> días de antelación.
        </p>
      </div>
    </form>
<% } -%>
  </section>

<% if (usuario !== null) { -%>
<% if (avisos.length) { -%>
  <section class="bento-celda bento-aviso bento-md-3 bento-lg-4" role="alert" aria-labelledby="avisos-titulo">
    <h2 class="bento-etiqueta" id="avisos-titulo">Avisos del restaurante</h2>
    <ul class="ps-3 mb-3">
<% for (const a of avisos) { -%>
      <li class="mb-1">
        <%= a.message %>
<% if (a.reservation_id !== null) { -%>
        <a class="fw-semibold" href="/reservas/<%= Number(a.reservation_id) %>">Ver la reserva</a>
<% } -%>
      </li>
<% } -%>
    </ul>
    <form class="bento-pie" method="post" action="/avisos/leidos">
      <%- Csrf.campo() %>
      <button class="btn btn-sm btn-warning" type="submit">Entendido</button>
    </form>
  </section>
<% } -%>

  <section class="bento-celda <%= avisos.length ? 'bento-md-6 bento-lg-8 bento-alta' : 'bento-md-4 bento-lg-8' %>" aria-labelledby="proximas-titulo">
    <div class="bento-cabecera">
      <h2 class="h5" id="proximas-titulo">Próximas reservas</h2>
      <a href="/reservas">Ver todas</a>
    </div>
<% if (proximas.length) { -%>
    <div class="list-group lista-bento">
<% for (const r of proximas.slice(0, 3)) { -%>
      <%- fragmento('cliente/_tarjeta-reserva', { r }) %>
<% } -%>
    </div>
<% } else { -%>
    <p class="text-body-secondary mb-0">No tienes ninguna reserva pendiente.</p>
<% } -%>
  </section>

  <section class="bento-celda bento-suave bento-enlace <%= avisos.length ? 'bento-md-3' : 'bento-md-2' %> bento-lg-4">
    <h2 class="bento-etiqueta">Reservas pendientes</h2>
    <p class="cifra-bento text-primary-emphasis mb-2"><%= proximas.length %></p>
    <a class="stretched-link bento-pie fw-semibold" href="/reservas">Ver mis reservas ›</a>
  </section>
<% } -%>

  <section class="bento-celda bento-enlace bento-md-2 bento-lg-4">
    <span class="icono-redondo mb-3" aria-hidden="true">+</span>
    <h2 class="h5">¿Sois más de <%= Number(cfg?.max_party ?? 8) %>?</h2>
    <p class="text-body-secondary">
      Para grupos grandes envía una solicitud y el restaurante te confirma la mesa.
    </p>
    <a class="stretched-link bento-pie" href="/grupos">Solicitar mesa para un grupo</a>
  </section>

  <section class="bento-celda bento-enlace bento-md-2 bento-lg-4">
    <span class="icono-redondo mb-3" aria-hidden="true">#</span>
    <h2 class="h5">¿Reservaste por teléfono?</h2>
    <p class="text-body-secondary">
      Añade a tu cuenta una reserva hecha en el local con su código y tu teléfono.
    </p>
    <a class="stretched-link bento-pie" href="/vincular">Añadir una reserva</a>
  </section>

  <section class="bento-celda bento-enlace bento-md-2 bento-lg-4">
    <span class="icono-redondo mb-3" aria-hidden="true">✓</span>
    <h2 class="h5">Tus reservas</h2>
    <p class="text-body-secondary">
      Consulta, cambia o cancela tus reservas y enseña su código QR al llegar.
    </p>
    <a class="stretched-link bento-pie" href="<%= usuario !== null ? '/reservas' : '/entrar?next=%2Freservas' %>">
      <%= usuario !== null ? 'Ver mis reservas' : 'Entrar para verlas' %>
    </a>
  </section>
</div>
