<%# Iniciar sesión. Variables: email, errores y next. %>
<h1 class="h3 mb-3">Iniciar sesión</h1>

<% if (errores._ !== undefined) { -%>
  <div class="alert alert-danger" role="alert"><%= errores._ %></div>
<% } -%>

<form class="card card-body shadow-sm mb-3" method="post" action="<%= url('/entrar', { next }) %>">
  <%- Csrf.campo() %>
  <%- campo('email', 'Correo electrónico', email, { type: 'email', required: true, maxlength: 254, autocomplete: 'username', autofocus: email === '' }) %>
  <%- campo('password', 'Contraseña', '', { type: 'password', required: true, maxlength: 128, autocomplete: 'current-password', autofocus: email !== '' }) %>
  <button class="btn btn-primary btn-lg w-100" type="submit">Entrar</button>
</form>

<p class="text-center mb-2"><a href="/recuperar">¿Has olvidado tu contraseña?</a></p>
<p class="text-center">¿No tienes cuenta? <a href="<%= url('/registro', { next }) %>">Crea una</a></p>
