<%# Entrar al panel. Variables: email, error y next. %>
<div class="py-md-4">
  <h1 class="h3 mb-1">Panel del restaurante</h1>
  <p class="text-body-secondary mb-3">Acceso del personal y de administración.</p>

<% if (error !== null) { -%>
  <div class="alert alert-danger" role="alert"><%= error %></div>
<% } -%>

  <form class="card card-body shadow-sm" method="post" action="<%= url('/panel/entrar', { next }) %>">
    <%- Csrf.campo() %>
    <%- campo('email', 'Correo electrónico', email, { type: 'email', required: true, maxlength: 254, autocomplete: 'username', autofocus: email === '' }) %>
    <%- campo('password', 'Contraseña', '', { type: 'password', required: true, maxlength: 128, autocomplete: 'current-password', autofocus: email !== '' }) %>
    <button class="btn btn-primary btn-lg w-100" type="submit">Entrar</button>
  </form>
  <p class="small text-body-secondary mt-3">
    La sesión se cierra tras 30 minutos sin actividad y, como mucho, a las 8 horas.
    Si has olvidado la contraseña, pídesela a administración.
  </p>
</div>
