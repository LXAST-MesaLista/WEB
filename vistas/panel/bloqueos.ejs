<%# Bloqueos. Variables: hoy, datos, errores, mesas y bloqueos. %>
<h1 class="h3 mb-2">Bloqueos</h1>
<p class="text-body-secondary">
  Una mesa bloqueada no se ofrece a los clientes ni para sentar a nadie durante ese horario.
  Si ya tiene reservas, primero muévelas («Mesas…» en la agenda) o cancélalas.
</p>

<% for (const texto of Object.values(errores)) { -%>
<div class="alert alert-danger" role="alert"><%= texto %></div>
<% } -%>

<form class="card card-body shadow-sm mb-4" method="post" action="/panel/bloqueos" data-bloqueo>
  <%- Csrf.campo() %>
  <div class="row g-4">
    <div class="col-lg-5">
      <h2 class="h5">¿Cuándo?</h2>
      <label class="form-label" for="f-date">Día</label>
      <input class="form-control mb-3" type="date" id="f-date" name="date" value="<%= datos.date %>" min="<%= hoy %>" required>
      <div class="row g-2 mb-2">
        <div class="col">
          <label class="form-label" for="f-from">Desde</label>
          <input class="form-control" type="time" id="f-from" name="from" value="<%= datos.from %>" step="300" required data-hora-bloqueo>
        </div>
        <div class="col">
          <label class="form-label" for="f-to">Hasta</label>
          <input class="form-control" type="time" id="f-to" name="to" value="<%= datos.to %>" step="300" required data-hora-bloqueo>
        </div>
      </div>
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="f-todo" name="todo_dia" value="1"<%- datos.todo_dia ? ' checked' : '' %> data-todo-dia>
        <label class="form-check-label" for="f-todo">Todo el día</label>
      </div>
      <label class="form-label" for="f-reason">Motivo</label>
      <input class="form-control" type="text" id="f-reason" name="reason" value="<%= datos.reason %>" minlength="2" maxlength="120" required
             placeholder="Evento privado, avería…">
    </div>
    <div class="col-lg-7">
      <h2 class="h5">¿Qué mesas?</h2>
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="f-all" name="all" value="1"<%- datos.all ? ' checked' : '' %> data-todas-mesas>
        <label class="form-check-label" for="f-all"><strong>Todas las mesas</strong> (cierra la franja: no se ofrece ninguna hora)</label>
      </div>
      <div class="d-flex flex-wrap gap-3" data-lista-mesas>
<% for (const t of mesas) { const id = Number(t.id); -%>
        <div class="form-check opcion-mesa">
          <input class="form-check-input" type="checkbox" name="table_ids[]" value="<%= id %>" id="f-b-<%= id %>"
                 <%- datos.table_ids.includes(id) ? 'checked' : '' %>>
          <label class="form-check-label" for="f-b-<%= id %>">Mesa <%= t.code %> · <%= t.zone %></label>
        </div>
<% } -%>
      </div>
    </div>
  </div>
  <div class="mt-3"><button class="btn btn-primary" type="submit">Bloquear</button></div>
</form>

<h2 class="h5">Bloqueos próximos</h2>
<% if (!bloqueos.length) { -%>
<p class="text-body-secondary">No hay bloqueos próximos.</p>
<% } else { -%>
<div class="table-responsive">
  <table class="table align-middle">
    <thead><tr><th scope="col">Día</th><th scope="col">Horario</th><th scope="col">Mesas</th><th scope="col">Motivo</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead>
    <tbody>
<% for (const b of bloqueos) { -%>
      <tr>
        <td><%= Formato.fechaCorta(b.date) %><%- b.active ? ' <span class="badge text-bg-primary">Ahora</span>' : '' %></td>
        <td><%= b.from %>–<%= b.to %></td>
        <td><%= b.table === null ? 'Todas' : `Mesa ${b.table}` %></td>
        <td><%= b.reason %></td>
        <td class="text-end">
          <form method="post" action="/panel/bloqueos/<%= Number(b.id) %>/quitar"
                data-confirmar="<%= `¿Quitar el bloqueo de ${b.table === null ? 'todas las mesas' : `la mesa ${b.table}`} (${b.from}–${b.to})?` %>">
            <%- Csrf.campo() %>
            <button class="btn btn-sm btn-outline-secondary" type="submit">Quitar</button>
          </form>
        </td>
      </tr>
<% } -%>
    </tbody>
  </table>
</div>
<% } -%>
