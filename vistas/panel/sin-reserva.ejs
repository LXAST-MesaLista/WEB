<%# Cliente sin reserva. Variables: personas, mesas y aqui. %>
<h1 class="h3 mb-3">Cliente sin reserva</h1>

<form class="d-flex flex-wrap align-items-end gap-2 mb-3" method="get" action="/panel/sin-reserva" data-auto-enviar>
  <div>
    <label class="form-label" for="f-personas">¿Cuántas personas?</label>
    <input class="form-control campo-numero" type="number" id="f-personas" name="personas" min="1" max="50" value="<%= personas %>" required>
  </div>
  <button class="btn btn-outline-primary sin-js" type="submit">Ver mesas</button>
</form>
<p class="text-body-secondary">
  Mesas libres ahora y sin reservas durante toda la duración de una reserva.
  Si el grupo no cabe en una, marca varias para unirlas.
</p>

<% if (!mesas.length) { -%>
<div class="card card-body text-center text-body-secondary">No hay ninguna mesa libre durante toda la duración de una reserva.</div>
<% } else { -%>
<form method="post" action="<%= aqui %>" data-suma-plazas data-base="0" data-necesarias="<%= personas %>">
  <%- Csrf.campo() %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-3">
<% for (const t of mesas) { const id = Number(t.id); -%>
    <div class="col">
      <article class="card h-100 ficha-mesa estado-free">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-baseline">
            <h2 class="h4 mb-0"><%= t.code %></h2>
            <span class="small text-body-secondary"><%= t.join_only ? `extra · hasta ${Number(t.max_capacity)}` : `${Number(t.min_capacity)}–${Number(t.max_capacity)} pers.` %></span>
          </div>
          <p class="small mb-2"><%= t.zone %><%= t.fits ? ' · cabe el grupo' : '' %></p>
          <div class="d-flex flex-wrap gap-2 align-items-center">
<% if (t.fits) { -%>
            <button class="btn btn-sm btn-primary" type="submit" name="sentar" value="<%= id %>">Sentar aquí</button>
<% } -%>
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" name="table_ids[]" value="<%= id %>" id="f-mesa-<%= id %>" data-plazas="<%= Number(t.max_capacity) %>">
              <label class="form-check-label" for="f-mesa-<%= id %>">Unir</label>
            </div>
          </div>
        </div>
      </article>
    </div>
<% } -%>
  </div>
  <div class="d-flex flex-wrap align-items-center gap-3">
    <button class="btn btn-primary" type="submit" name="sentar" value="elegidas">Sentar en las mesas marcadas</button>
    <span class="small" data-suma-texto aria-live="polite">Marca una o varias mesas para unirlas.</span>
  </div>
</form>
<% } -%>
