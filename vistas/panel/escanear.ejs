<%# Escanear QR. Variables: resultado (tipo, titulo, lineas, anticipar) o null. %>
<% const clase = { ok: 'success', error: 'danger', alerta: 'danger' }; -%>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0 me-auto">Escanear QR</h1>
  <a class="btn btn-outline-secondary" href="/panel/agenda">Buscar por nombre o teléfono</a>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="lector mb-2" data-lector>
      <video playsinline muted></video>
      <div class="marco" aria-hidden="true"></div>
    </div>
    <p class="small text-body-secondary mb-0" data-lector-estado aria-live="polite">
      Pulsa «Activar cámara» para empezar. Hace falta HTTPS y permiso para usar la cámara.
    </p>
  </div>

  <div class="col-lg-5">
<% if (resultado !== null) { -%>
    <section class="alert alert-<%= clase[resultado.tipo] %> <%= resultado.tipo === 'alerta' ? 'border-3 border-danger' : '' %>"
             role="<%= resultado.tipo === 'ok' ? 'status' : 'alert' %>" data-resultado="<%= resultado.tipo %>">
      <h2 class="h4 alert-heading"><%= resultado.titulo %></h2>
<% for (const l of resultado.lineas) { -%>
      <p class="mb-1 texto-con-saltos"><%= l %></p>
<% } -%>
<% if (resultado.anticipar) { -%>
      <form class="mt-3" method="post" action="/panel/escanear">
        <%- Csrf.campo() %>
        <input type="hidden" name="qr" value="<%= resultado.anticipar %>">
        <input type="hidden" name="early" value="1">
        <button class="btn btn-primary" type="submit">Registrar llegada anticipada</button>
      </form>
<% } -%>
    </section>
<% } -%>

    <button class="btn btn-primary btn-lg w-100 mb-3" type="button" data-lector-activar>Activar cámara</button>

    <form class="card card-body" method="post" action="/panel/escanear" data-lector-form>
      <%- Csrf.campo() %>
      <label class="form-label" for="f-qr">Contenido del QR</label>
      <input class="form-control mb-2" type="text" id="f-qr" name="qr" autocomplete="off" spellcheck="false" maxlength="120" required
             placeholder="ML1.…" <%- resultado === null ? 'autofocus' : '' %>>
      <p class="form-text mt-0">Con un lector de QR USB, el código se escribe aquí solo.</p>
      <button class="btn btn-outline-primary" type="submit">Registrar llegada</button>
    </form>
  </div>
</div>
