<%# Confirmar reserva. Variables: cfg, fecha, hora, personas, volver, extras, requestId y errores. %>
<a class="d-inline-block mb-3" href="<%= volver %>">‹ Cambiar día u hora</a>
<h1 class="h3 mb-3">Confirmar reserva</h1>

<div class="row g-4">
  <div class="col-lg-7">
    <%- fragmento('cliente/_resumen', { fecha, hora, personas }) %>

<% if (errores._ !== undefined) { -%>
    <div class="alert alert-danger" role="alert"><%= errores._ %></div>
<% } -%>

    <form method="post" action="<%= url('/reservar/confirmar', { fecha, personas, hora }) %>">
      <%- Csrf.campo() %>
      <input type="hidden" name="request_id" value="<%= requestId %>">
      <%- fragmento('cliente/_extras', { cfg, extras, errores }) %>
      <button class="btn btn-primary btn-lg w-100" type="submit">Confirmar reserva</button>
    </form>
  </div>
  <div class="col-lg-5">
    <div class="card card-body bg-body-tertiary border-0">
      <h2 class="h6">Antes de confirmar</h2>
      <ul class="small text-body-secondary mb-0 ps-3">
        <li>Te enviaremos un correo con la reserva y un código QR para enseñar al llegar.</li>
        <li>Puedes cambiarla o cancelarla desde «Mis reservas» hasta unas horas antes.</li>
        <li>Si no vienes y no cancelas, la reserva queda como «no presentada».</li>
      </ul>
    </div>
  </div>
</div>
